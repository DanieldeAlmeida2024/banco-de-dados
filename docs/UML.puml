@startuml
skinparam classAttributeIconSize 0
class ServicoPessoas {
  +cadastrar(nome, email)
  +listar()
  +consultar(id)
  +atualizar(id, nome, email)
  +excluir(id)
}
class RepositorioPessoas {
  +preparar()
  +cadastrar(nome, email)
  +listar()
  +consultar(id)
  +atualizar(id, nome, email)
  +excluir(id)
}
class Pessoa {
  +id: inteiro
  +nome: texto
  +email: texto
}
ServicoPessoas --> RepositorioPessoas
RepositorioPessoas ..> Pessoa
@enduml
